[Unit]
Description=Domonetka offers
After=network.target

[Service]
Type=simple
User=domonetka
Group=domonetka
WorkingDirectory=/opt/domonetka
EnvironmentFile=/etc/domonetka.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/domonetka/server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/domonetka/data
UMask=0027
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
